APP_NAME=MailBatch
DB_CONNECTION=mysql
DB_DATABASE=mailbatch
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database

MAILBATCH_MAX_BATCH_SIZE=50
MAILBATCH_DEFAULT_DAILY_LIMIT=500
MAILBATCH_MAX_RETRIES=3
MAILBATCH_UPLOAD_MAX_KB=5120
MAILBATCH_MAX_ROWS=5000
MAILBATCH_DELAY_SECONDS=2
MAILBATCH_QUEUE=mailbatch
MAILBATCH_WORK_SECONDS=15
MAILBATCH_ADMIN_EMAIL=admin@example.com
# MAILBATCH_ADMIN_PASSWORD=   (leave empty to auto-generate on seed)
